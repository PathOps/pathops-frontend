# The PathOps UI: static files, the SPA's routes falling back to index.html.
# /api, /.well-known and /healthz never reach this server (the Cell routes
# them to the Tenant CP at the same origin). PATHOPS_DEX_ORIGIN and
# PATHOPS_EVENTS_ORIGIN are the only other origins the page talks to (its
# OIDC sign-in, Decision 0060; its live updates, Decision 0063: Socket.IO's
# HTTPS long-polling and its WebSocket upgrade at wss:// of the same host).
map "${PATHOPS_EVENTS_ORIGIN}" $pathops_events_ws {
    "~^https://(?<events_host>[^/]+)$" "wss://$events_host";
    default "";
}

# The listener (nginx/listen.sh, at start): HTTPS only on 8443 with the
# certificate mounted at /etc/pathops-frontend/tls (a Cell: its Cell CA leaf
# for pathops-frontend.pathops-system.svc, which Traefik re-encrypts to);
# plain HTTP on 8080 only without one (a workstation).
server {
    include /etc/nginx/conf.d/listen.inc;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${PATHOPS_DEX_ORIGIN} ${PATHOPS_EVENTS_ORIGIN} $pathops_events_ws; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${PATHOPS_DEX_ORIGIN} ${PATHOPS_EVENTS_ORIGIN} $pathops_events_ws; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${PATHOPS_DEX_ORIGIN} ${PATHOPS_EVENTS_ORIGIN} $pathops_events_ws; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri /index.html;
    }
}
